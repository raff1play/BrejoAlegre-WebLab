{
  "name": "brejo-alegre-web-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --mode development",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "validate:repo": "node scripts/validate-repository.mjs",
    "build": "npm run build:production",
    "build:staging": "npm run typecheck && vite build --mode staging",
    "build:production": "npm run typecheck && vite build --mode production",
    "check": "npm run validate:repo && npm run test:unit && npm run build:staging",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "node tests/e2e/play.cjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.35.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.0"
  }
}
